  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "4.20260305.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "4.72.0"
  }
}
